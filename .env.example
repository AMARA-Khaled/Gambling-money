# Copy to .env.local and fill in. NEVER commit real secrets (.env.local is gitignored).

# --- Neon Postgres ---
# Direct (non-pooled) connection — used by migrations (drizzle-kit / db:migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require&channel_binding=require"
# Pooled connection — used by the app at runtime
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require&channel_binding=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
# Set to true behind proxies / on non-Vercel hosts (harmless on Vercel)
AUTH_TRUST_HOST=true

# --- Google OAuth (auto-detected by the Google provider) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
